### Create organization
POST http://localhost:8080/api/v1/organizations
Content-Type: application/json

{
  "name": "Personal Workspace"
}

###

### Get organizations
GET http://localhost:8080/api/v1/organizations

###

### Create project
POST http://localhost:8080/api/v1/projects
Content-Type: application/json

{
  "organizationId": "d9e446a6-c314-413a-8573-2a621495f565",
  "name": "Brand Engine",
  "description": "AI-assisted brand and domain research project"
}

###

### Get projects
GET http://localhost:8080/api/v1/projects

###
GET http://localhost:8080/api/v1/projects/58660908-5d6f-4ae6-9b18-6ebed99ba513

###
PUT http://localhost:8080/api/v1/projects/58660908-5d6f-4ae6-9b18-6ebed99ba513
Content-Type: application/json

{
  "organizationId": "d9e446a6-c314-413a-8573-2a621495f565",
  "name": "Brand Engine Updated 2",
  "description": "Updated description from PUT endpoint"
}

###
DELETE http://localhost:8080/api/v1/projects/58660908-5d6f-4ae6-9b18-6ebed99ba513

###
### Create Document
POST http://localhost:8080/api/v1/documents
Content-Type: application/json

{
  "projectId": "58660908-5d6f-4ae6-9b18-6ebed99ba513",
  "name": "Architecture Diagram",
  "originalFilename": "architecture.pdf",
  "contentType": "application/pdf",
  "storageKey": "documents/architecture.pdf",
  "sizeBytes": 245760
}

